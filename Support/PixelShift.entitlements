<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Read and write files the user drops, picks in a panel, or sends from Finder. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Remember the watermark image across launches. -->
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- Sparkle: download update feeds and archives. -->
    <key>com.apple.security.network.client</key><true/>
    <!-- Sparkle: reach its installer, which runs outside the sandbox. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.riviantrackr.pixelshift-spks</string>
        <string>com.riviantrackr.pixelshift-spki</string>
    </array>
</dict>
</plist>
